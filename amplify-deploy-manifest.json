{
    "version": 1,
    "routes": [
        {
            "path": "/api/layout",
            "target": { "kind": "Compute", "src": "default" }
        },
        {
            "path": "/*",
            "target": { "kind": "Static" }
        }
    ],
    "computeResources": [
        {
            "name": "default",
            "entrypoint": "amplify-server.mjs",
            "runtime": "nodejs22.x"
        }
    ],
    "framework": {
        "name": "eleventy",
        "version": "3.1.2"
    }
}
